# Stripe secret key (server-side only — NEVER prefix with NEXT_PUBLIC_).
# Grab from https://dashboard.stripe.com/apikeys
# Use sk_test_... locally and sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Optional: explicit canonical site URL used to build success/cancel URLs.
# Defaults to the Origin header from the incoming request, then to
# https://modsbymail.com, if this isn't set.
# NEXT_PUBLIC_SITE_URL=https://modsbymail.com
